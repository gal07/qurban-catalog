---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PageHeader from "../../../components/admin/layout/PageHeader.astro";
import FormCard from "../../../components/admin/forms/FormCard.astro";
import LocalizedInput from "../../../components/admin/forms/LocalizedInput.astro";
import SaveButton from "../../../components/admin/forms/SaveButton.astro";
import ActionBar from "../../../components/admin/layout/ActionBar.astro";
import DynamicList from "../../../components/admin/forms/DynamicList.astro";
---

<AdminLayout title="Cara Pemesanan">
    <PageHeader
        title="Cara Pemesanan"
        description="Edit subtitle and manage steps for the 'How To Buy' section"
        icon="📋"
    />

    <form id="how-to-buy-form">
        <FormCard title="Subtitle" description="Section subtitle text">
            <LocalizedInput
                name="subtitle"
                labelId="Subtitle (ID)"
                labelEn="Subtitle (EN)"
                type="textarea"
                placeholderId="Proses mudah dan transparan..."
                placeholderEn="Easy and transparent process..."
                rows={2}
            />
        </FormCard>

        <FormCard
            title="Steps"
            description="Manage ordering steps"
            class="mt-6"
        >
            <div id="steps-list-container">
                <DynamicList
                    addButtonText="+ Add Step"
                    emptyMessage="No steps yet. Click the button above to add one."
                />
            </div>
        </FormCard>

        <ActionBar align="right" class="mt-6">
            <SaveButton />
        </ActionBar>
    </form>
</AdminLayout>

<script>
    import { db } from "../../../lib/firebase";
    import { doc, getDoc, setDoc } from "firebase/firestore";
    import { showToast } from "../../../lib/toast";

    interface Step {
        title: string;
        title_en: string;
        description: string;
        description_en: string;
    }

    document.addEventListener("astro:page-load", async () => {
        const form = document.getElementById(
            "how-to-buy-form",
        ) as HTMLFormElement;
        if (!form) return;

        const container = document.querySelector(
            "#steps-list-container .list-items",
        ) as HTMLElement;
        const addButton = document.querySelector(
            "#steps-list-container .add-item-btn",
        ) as HTMLButtonElement;
        const emptyState = document.querySelector(
            "#steps-list-container .empty-state",
        ) as HTMLElement;

        if (!container || !addButton || !emptyState) return;

        let steps: Step[] = [];

        function renderSteps() {
            if (steps.length === 0) {
                container.innerHTML = "";
                emptyState.classList.remove("hidden");
            } else {
                emptyState.classList.add("hidden");
                container.innerHTML = steps
                    .map((item, index) => {
                        return `
                            <div class="list-item" data-index="${index}">
                                <div class="list-item-content">
                                    <div class="space-y-4">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                                    Langkah ${index + 1} - Judul (ID)
                                                </label>
                                                <input
                                                    type="text"
                                                    name="step_title_${index}"
                                                    value="${item.title || ""}"
                                                    placeholder="Pilih Hewan Qurban"
                                                    class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                                />
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                                    Step ${index + 1} - Title (EN)
                                                </label>
                                                <input
                                                    type="text"
                                                    name="step_title_${index}_en"
                                                    value="${item.title_en || ""}"
                                                    placeholder="Choose Qurban Animal"
                                                    class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                                />
                                            </div>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                                    Deskripsi (ID)
                                                </label>
                                                <textarea
                                                    name="step_description_${index}"
                                                    rows="3"
                                                    placeholder="Pilih hewan qurban sesuai kebutuhan..."
                                                    class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                                >${item.description || ""}</textarea>
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium text-slate-700 mb-1">
                                                    Description (EN)
                                                </label>
                                                <textarea
                                                    name="step_description_${index}_en"
                                                    rows="3"
                                                    placeholder="Choose the qurban animal according to your needs..."
                                                    class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                                >${item.description_en || ""}</textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <button
                                    type="button"
                                    class="remove-item-btn"
                                    data-index="${index}"
                                    title="Remove step"
                                >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                        `;
                    })
                    .join("");

                // Attach remove button listeners
                container
                    .querySelectorAll(".remove-item-btn")
                    .forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            const index = parseInt(
                                (e.currentTarget as HTMLElement).dataset
                                    .index || "0",
                            );
                            steps.splice(index, 1);
                            renderSteps();
                        });
                    });
            }
        }

        // Add button handler
        addButton.addEventListener("click", () => {
            steps.push({
                title: "",
                title_en: "",
                description: "",
                description_en: "",
            });
            renderSteps();
        });

        // Load data from Firestore
        try {
            const docRef = doc(db, "content", "how_to_buy");
            const docSnap = await getDoc(docRef);

            if (docSnap.exists()) {
                const data = docSnap.data();

                // Set subtitle fields
                const subtitleInput = form.querySelector(
                    '[name="subtitle"]',
                ) as HTMLTextAreaElement;
                const subtitleEnInput = form.querySelector(
                    '[name="subtitle_en"]',
                ) as HTMLTextAreaElement;
                if (subtitleInput) subtitleInput.value = data.subtitle || "";
                if (subtitleEnInput)
                    subtitleEnInput.value = data.subtitle_en || "";

                // Set steps
                steps = data.steps || [];
                renderSteps();
            }
        } catch (error) {
            console.error("Error loading data:", error);
            showToast("Gagal memuat data. Silakan coba lagi.", "error");
        }

        // Handle form submit
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const submitBtn = form.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement;
            if (submitBtn) {
                submitBtn.textContent = "Menyimpan...";
                submitBtn.disabled = true;
            }

            try {
                // Collect subtitle data
                const subtitleInput = form.querySelector(
                    '[name="subtitle"]',
                ) as HTMLTextAreaElement;
                const subtitleEnInput = form.querySelector(
                    '[name="subtitle_en"]',
                ) as HTMLTextAreaElement;

                // Collect steps data
                const stepsData = steps
                    .map((_, index) => {
                        const titleInput = form.querySelector(
                            `[name="step_title_${index}"]`,
                        ) as HTMLInputElement;
                        const titleEnInput = form.querySelector(
                            `[name="step_title_${index}_en"]`,
                        ) as HTMLInputElement;
                        const descInput = form.querySelector(
                            `[name="step_description_${index}"]`,
                        ) as HTMLTextAreaElement;
                        const descEnInput = form.querySelector(
                            `[name="step_description_${index}_en"]`,
                        ) as HTMLTextAreaElement;

                        return {
                            title: titleInput?.value || "",
                            title_en: titleEnInput?.value || "",
                            description: descInput?.value || "",
                            description_en: descEnInput?.value || "",
                        };
                    })
                    .filter((step) => step.title && step.description);

                const data = {
                    subtitle: subtitleInput?.value || "",
                    subtitle_en: subtitleEnInput?.value || "",
                    steps: stepsData,
                    updatedAt: new Date().toISOString(),
                };

                await setDoc(doc(db, "content", "how_to_buy"), data);
                showToast("Data berhasil disimpan!", "success");
            } catch (error) {
                console.error("Error saving data:", error);
                showToast(
                    "Gagal menyimpan data: " + (error as Error).message,
                    "error",
                );
            } finally {
                if (submitBtn) {
                    submitBtn.textContent = "Simpan Perubahan";
                    submitBtn.disabled = false;
                }
            }
        });
    });
</script>
