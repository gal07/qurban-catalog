---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PageHeader from "../../../components/admin/layout/PageHeader.astro";
import FormCard from "../../../components/admin/forms/FormCard.astro";
import LocalizedInput from "../../../components/admin/forms/LocalizedInput.astro";
import SaveButton from "../../../components/admin/forms/SaveButton.astro";
import ActionBar from "../../../components/admin/layout/ActionBar.astro";
import DynamicList from "../../../components/admin/forms/DynamicList.astro";
---

<AdminLayout title="Sedekah Daging">
    <PageHeader
        title="Sedekah Daging"
        description="Edit the content of the Sedekah Daging section"
        icon="🥩"
    />

    <form id="sedekah-form">
        <FormCard
            title="Section Header"
            description="Badge, title, and description"
        >
            <div class="space-y-4">
                <LocalizedInput
                    name="badge"
                    labelId="Badge Text (ID)"
                    labelEn="Badge Text (EN)"
                    type="text"
                    placeholderId="Program Spesial"
                    placeholderEn="Special Program"
                />

                <LocalizedInput
                    name="title"
                    labelId="Title (ID)"
                    labelEn="Title (EN)"
                    type="text"
                    placeholderId="Sedekah Daging"
                    placeholderEn="Meat Alms"
                />

                <LocalizedInput
                    name="titleHighlight"
                    labelId="Title Highlight (ID)"
                    labelEn="Title Highlight (EN)"
                    type="text"
                    placeholderId="Sebar Bahagia"
                    placeholderEn="Spread Happiness"
                />

                <LocalizedInput
                    name="description"
                    labelId="Deskripsi (ID)"
                    labelEn="Description (EN)"
                    type="textarea"
                    placeholderId="Berbagi kebahagiaan dengan daging qurban..."
                    placeholderEn="Share happiness with qurban meat..."
                    rows={3}
                />
            </div>
        </FormCard>

        <FormCard
            title="Features"
            description="Manage program features"
            class="mt-6"
        >
            <div id="features-list-container">
                <DynamicList
                    addButtonText="+ Add Feature"
                    emptyMessage="No features yet. Click the button above to add one."
                />
            </div>
        </FormCard>

        <ActionBar align="right" class="mt-6">
            <SaveButton />
        </ActionBar>
    </form>
</AdminLayout>

<script>
    import { db } from "../../../lib/firebase";
    import { doc, getDoc, setDoc } from "firebase/firestore";
    import { showToast } from "../../../lib/toast";

    document.addEventListener("astro:page-load", async () => {
        const form = document.getElementById("sedekah-form") as HTMLFormElement;
        if (!form) return;

        const container = document.querySelector(
            "#features-list-container .list-items",
        ) as HTMLElement;
        const addButton = document.querySelector(
            "#features-list-container .add-item-btn",
        ) as HTMLButtonElement;
        const emptyState = document.querySelector(
            "#features-list-container .empty-state",
        ) as HTMLElement;

        if (!container || !addButton || !emptyState) return;

        let features: Array<{ text: string; text_en: string }> = [];

        function renderFeatures() {
            if (features.length === 0) {
                container.innerHTML = "";
                emptyState.classList.remove("hidden");
            } else {
                emptyState.classList.add("hidden");
                container.innerHTML = features
                    .map((item, index) => {
                        return `
                            <div class="list-item" data-index="${index}">
                                <div class="list-item-content">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                                Fitur ${index + 1} (ID)
                                            </label>
                                            <input
                                                type="text"
                                                name="feature_${index}"
                                                value="${item.text || ""}"
                                                placeholder="Masukkan fitur..."
                                                class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                            />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                                Feature ${index + 1} (EN)
                                            </label>
                                            <input
                                                type="text"
                                                name="feature_${index}_en"
                                                value="${item.text_en || ""}"
                                                placeholder="Enter feature..."
                                                class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                            />
                                        </div>
                                    </div>
                                </div>
                                
                                <button
                                    type="button"
                                    class="remove-item-btn"
                                    data-index="${index}"
                                    title="Remove feature"
                                >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                        `;
                    })
                    .join("");

                // Attach remove button listeners
                container
                    .querySelectorAll(".remove-item-btn")
                    .forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            const index = parseInt(
                                (e.currentTarget as HTMLElement).dataset
                                    .index || "0",
                            );
                            features.splice(index, 1);
                            renderFeatures();
                        });
                    });
            }
        }

        // Add button handler
        addButton.addEventListener("click", () => {
            features.push({ text: "", text_en: "" });
            renderFeatures();
        });

        // Load data from Firestore
        try {
            const docRef = doc(db, "content", "sedekah_daging");
            const docSnap = await getDoc(docRef);

            if (docSnap.exists()) {
                const data = docSnap.data();

                // Set header fields
                const badgeInput = form.querySelector(
                    '[name="badge"]',
                ) as HTMLInputElement;
                const badgeEnInput = form.querySelector(
                    '[name="badge_en"]',
                ) as HTMLInputElement;
                const titleInput = form.querySelector(
                    '[name="title"]',
                ) as HTMLInputElement;
                const titleEnInput = form.querySelector(
                    '[name="title_en"]',
                ) as HTMLInputElement;
                const titleHighlightInput = form.querySelector(
                    '[name="titleHighlight"]',
                ) as HTMLInputElement;
                const titleHighlightEnInput = form.querySelector(
                    '[name="titleHighlight_en"]',
                ) as HTMLInputElement;
                const descInput = form.querySelector(
                    '[name="description"]',
                ) as HTMLTextAreaElement;
                const descEnInput = form.querySelector(
                    '[name="description_en"]',
                ) as HTMLTextAreaElement;

                if (badgeInput) badgeInput.value = data.badge || "";
                if (badgeEnInput) badgeEnInput.value = data.badge_en || "";
                if (titleInput) titleInput.value = data.title || "";
                if (titleEnInput) titleEnInput.value = data.title_en || "";
                if (titleHighlightInput)
                    titleHighlightInput.value = data.titleHighlight || "";
                if (titleHighlightEnInput)
                    titleHighlightEnInput.value = data.titleHighlight_en || "";
                if (descInput) descInput.value = data.description || "";
                if (descEnInput) descEnInput.value = data.description_en || "";

                // Set features
                features = data.features || [];
                renderFeatures();
            }
        } catch (error) {
            console.error("Error loading data:", error);
            showToast("Gagal memuat data. Silakan coba lagi.", "error");
        }

        // Handle form submit
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const submitBtn = form.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement;
            if (submitBtn) {
                submitBtn.textContent = "Menyimpan...";
                submitBtn.disabled = true;
            }

            try {
                // Collect header data
                const badgeInput = form.querySelector(
                    '[name="badge"]',
                ) as HTMLInputElement;
                const badgeEnInput = form.querySelector(
                    '[name="badge_en"]',
                ) as HTMLInputElement;
                const titleInput = form.querySelector(
                    '[name="title"]',
                ) as HTMLInputElement;
                const titleEnInput = form.querySelector(
                    '[name="title_en"]',
                ) as HTMLInputElement;
                const titleHighlightInput = form.querySelector(
                    '[name="titleHighlight"]',
                ) as HTMLInputElement;
                const titleHighlightEnInput = form.querySelector(
                    '[name="titleHighlight_en"]',
                ) as HTMLInputElement;
                const descInput = form.querySelector(
                    '[name="description"]',
                ) as HTMLTextAreaElement;
                const descEnInput = form.querySelector(
                    '[name="description_en"]',
                ) as HTMLTextAreaElement;

                // Collect features data
                const featuresData = features
                    .map((_, index) => {
                        const textInput = form.querySelector(
                            `[name="feature_${index}"]`,
                        ) as HTMLInputElement;
                        const textEnInput = form.querySelector(
                            `[name="feature_${index}_en"]`,
                        ) as HTMLInputElement;

                        return {
                            text: textInput?.value || "",
                            text_en: textEnInput?.value || "",
                        };
                    })
                    .filter((feature) => feature.text && feature.text_en);

                const data = {
                    badge: badgeInput?.value || "",
                    badge_en: badgeEnInput?.value || "",
                    title: titleInput?.value || "",
                    title_en: titleEnInput?.value || "",
                    titleHighlight: titleHighlightInput?.value || "",
                    titleHighlight_en: titleHighlightEnInput?.value || "",
                    description: descInput?.value || "",
                    description_en: descEnInput?.value || "",
                    features: featuresData,
                    updatedAt: new Date().toISOString(),
                };

                await setDoc(doc(db, "content", "sedekah_daging"), data);
                showToast("Data berhasil disimpan!", "success");
            } catch (error) {
                console.error("Error saving data:", error);
                showToast(
                    "Gagal menyimpan data: " + (error as Error).message,
                    "error",
                );
            } finally {
                if (submitBtn) {
                    submitBtn.textContent = "Simpan Perubahan";
                    submitBtn.disabled = false;
                }
            }
        });
    });
</script>
