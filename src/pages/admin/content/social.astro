---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PageHeader from "../../../components/admin/layout/PageHeader.astro";
import FormCard from "../../../components/admin/forms/FormCard.astro";
import SaveButton from "../../../components/admin/forms/SaveButton.astro";
import ActionBar from "../../../components/admin/layout/ActionBar.astro";
import DynamicList from "../../../components/admin/forms/DynamicList.astro";
---

<AdminLayout title="Ikuti Kami">
    <PageHeader
        title="Social Media"
        description="Add and manage social media links displayed in the footer"
        icon="🔗"
    />

    <form id="social-form">
        <FormCard
            title="Social Media Links"
            description="Manage your social media presence"
        >
            <div id="social-list-container">
                <DynamicList
                    title="Links"
                    addButtonText="+ Add Social Media"
                    emptyMessage="No social links yet. Click the button above to add one."
                />
            </div>
        </FormCard>

        <ActionBar align="right" class="mt-6">
            <SaveButton />
        </ActionBar>
    </form>
</AdminLayout>

<script>
    import { db } from "../../../lib/firebase";
    import { doc, getDoc, setDoc } from "firebase/firestore";
    import { showToast } from "../../../lib/toast";
    import { AutoSaveManager } from "../../../lib/admin/AutoSave";
    import { UnsavedChangesManager } from "../../../lib/admin/UnsavedChanges";
    import { sanitizeHTML, sanitizeURL } from "../../../lib/security/sanitize";

    const platforms = [
        "Facebook",
        "Instagram",
        "Twitter",
        "WhatsApp",
        "YouTube",
        "TikTok",
        "LinkedIn",
    ];

    document.addEventListener("astro:page-load", async () => {
        const form = document.getElementById("social-form") as HTMLFormElement;
        if (!form) return;

        // Initialize form enhancements
        const autoSave = new AutoSaveManager("social-form", form);
        const unsavedChanges = new UnsavedChangesManager(form);

        const container = document.querySelector(
            "#social-list-container .list-items",
        ) as HTMLElement;
        const addButton = document.querySelector(
            "#social-list-container .add-item-btn",
        ) as HTMLButtonElement;
        const emptyState = document.querySelector(
            "#social-list-container .empty-state",
        ) as HTMLElement;

        if (!container || !addButton || !emptyState) return;

        let socialLinks: Array<{ platform: string; url: string }> = [];

        function renderLinks() {
            if (socialLinks.length === 0) {
                container.innerHTML = "";
                emptyState.classList.remove("hidden");
            } else {
                emptyState.classList.add("hidden");
                container.innerHTML = socialLinks
                    .map((item, index) => {
                        return `
                            <div class="list-item" data-index="${index}">
                                <div class="list-item-content">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                                Platform
                                            </label>
                                            <select
                                                name="platform_${index}"
                                                class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                            >
                                                <option value="">Select platform...</option>
                                                ${platforms
                                                    .map(
                                                        (p) =>
                                                            `<option value="${p}" ${p === item.platform ? "selected" : ""}>${p}</option>`,
                                                    )
                                                    .join("")}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                                URL
                                            </label>
                                            <input
                                                type="url"
                                                name="url_${index}"
                                                value="${sanitizeHTML(item.url || "")}"
                                                placeholder="https://..."
                                                class="block w-full rounded-lg shadow-sm sm:text-sm px-4 py-2 border border-slate-300 focus:border-sky-500 focus:ring-sky-500"
                                            />
                                        </div>
                                    </div>
                                </div>
                                
                                <button
                                    type="button"
                                    class="remove-item-btn"
                                    data-index="${index}"
                                    title="Remove social link"
                                >
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                        `;
                    })
                    .join("");

                // Attach remove button listeners
                container
                    .querySelectorAll(".remove-item-btn")
                    .forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            const index = parseInt(
                                (e.currentTarget as HTMLElement).dataset
                                    .index || "0",
                            );
                            socialLinks.splice(index, 1);
                            renderLinks();
                        });
                    });
            }
        }

        // Add button handler
        addButton.addEventListener("click", () => {
            socialLinks.push({ platform: "", url: "" });
            renderLinks();
        });

        // Load data from Firestore
        try {
            const docRef = doc(db, "content", "social");
            const docSnap = await getDoc(docRef);

            if (docSnap.exists()) {
                const data = docSnap.data();
                socialLinks = data.links || [];
                renderLinks();
            }
        } catch (error) {
            console.error("Error loading data:", error);
            showToast("Gagal memuat data. Silakan coba lagi.", "error");
        }

        // Handle form submit
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const submitBtn = form.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement;
            if (submitBtn) {
                submitBtn.textContent = "Menyimpan...";
                submitBtn.disabled = true;
            }

            try {
                // Collect data from form
                const links = socialLinks
                    .map((_, index) => {
                        const platformInput = form.querySelector(
                            `[name="platform_${index}"]`,
                        ) as HTMLSelectElement;
                        const urlInput = form.querySelector(
                            `[name="url_${index}"]`,
                        ) as HTMLInputElement;

                        return {
                            platform: platformInput?.value || "",
                            url: urlInput?.value || "",
                        };
                    })
                    .filter((link) => link.platform && link.url);

                const data = {
                    links,
                    updatedAt: new Date().toISOString(),
                };

                await setDoc(doc(db, "content", "social"), data);
                autoSave.clearDraft();
                unsavedChanges.markAsSaved();
                showToast("Data berhasil disimpan!", "success");
            } catch (error) {
                console.error("Error saving data:", error);
                showToast(
                    "Gagal menyimpan data: " + (error as Error).message,
                    "error",
                );
            } finally {
                if (submitBtn) {
                    submitBtn.textContent = "Simpan Perubahan";
                    submitBtn.disabled = false;
                }
            }
        });

        // Cleanup on page unload
        document.addEventListener("astro:before-swap", () => {
            autoSave.stop();
            unsavedChanges.stop();
        });
    });
</script>
