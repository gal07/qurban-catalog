---
interface Props {
    name: string;
    label: string;
    value?: string;
    required?: boolean;
    disabled?: boolean;
    error?: string;
    helpText?: string;
    class?: string;
}

const {
    name,
    label,
    value = "#3b82f6",
    required = false,
    disabled = false,
    error,
    helpText,
    class: className = "",
} = Astro.props;

const inputId = `color-${name}`;
const hasError = !!error;
---

<div class={`color-picker ${className}`}>
    <label for={inputId} class="block text-sm font-medium text-slate-700 mb-1">
        {label}
        {required && <span class="text-red-500 ml-1">*</span>}
    </label>

    <div class="flex items-center gap-3">
        <!-- Color Input -->
        <input
            type="color"
            id={inputId}
            name={name}
            value={value}
            required={required}
            disabled={disabled}
            class={`h-10 w-20 rounded-lg border-2 cursor-pointer transition-all ${
                hasError
                    ? "border-red-500"
                    : "border-slate-300 hover:border-sky-500"
            } ${disabled ? "opacity-50 cursor-not-allowed" : ""}`}
        />

        <!-- Hex Value Display -->
        <input
            type="text"
            value={value}
            readonly
            class="flex-1 px-3 py-2 text-sm font-mono bg-slate-50 border border-slate-300 rounded-lg text-slate-700"
            data-color-display={inputId}
        />
    </div>

    {error && <p class="field-error text-sm text-red-600 mt-1">{error}</p>}

    {
        helpText && !error && (
            <p class="text-xs text-slate-500 mt-1">{helpText}</p>
        )
    }
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const colorPickers = document.querySelectorAll(".color-picker");

        colorPickers.forEach((container) => {
            const colorInput = container.querySelector(
                'input[type="color"]',
            ) as HTMLInputElement;
            const displayInput = container.querySelector(
                "[data-color-display]",
            ) as HTMLInputElement;

            if (!colorInput || !displayInput) return;

            // Update display when color changes
            colorInput.addEventListener("input", (e) => {
                const value = (e.target as HTMLInputElement).value;
                displayInput.value = value.toUpperCase();
            });
        });
    });
</script>
