---
interface Props {
    name: string;
    label: string;
    currentUrl?: string;
    required?: boolean;
    disabled?: boolean;
    accept?: string;
    error?: string;
    helpText?: string;
    class?: string;
}

const {
    name,
    label,
    currentUrl = "",
    required = false,
    disabled = false,
    accept = "image/*",
    error,
    helpText,
    class: className = "",
} = Astro.props;

const inputId = `file-${name}`;
const previewId = `preview-${name}`;
const hasError = !!error;
---

<div class={`image-upload ${className}`}>
    <label for={inputId} class="block text-sm font-medium text-slate-700 mb-1">
        {label}
        {required && <span class="text-red-500 ml-1">*</span>}
    </label>

    <div class="mt-1 flex items-start gap-4">
        <!-- Preview -->
        <div
            id={previewId}
            class="preview-container flex-shrink-0 w-32 h-32 border-2 border-dashed border-slate-300 rounded-lg overflow-hidden bg-slate-50 flex items-center justify-center"
        >
            {
                currentUrl ? (
                    <img
                        src={currentUrl}
                        alt="Preview"
                        class="preview-image w-full h-full object-cover"
                    />
                ) : (
                    <svg
                        class="w-12 h-12 text-slate-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                    </svg>
                )
            }
        </div>

        <!-- File Input -->
        <div class="flex-1">
            <input
                type="file"
                id={inputId}
                name={name}
                accept={accept}
                required={required}
                disabled={disabled}
                class={`block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100 transition-colors ${
                    hasError ? "border-red-500" : ""
                } ${disabled ? "opacity-50 cursor-not-allowed" : "cursor-pointer"}`}
            />

            {
                error && (
                    <p class="field-error text-sm text-red-600 mt-1">{error}</p>
                )
            }

            {
                helpText && !error && (
                    <p class="text-xs text-slate-500 mt-1">{helpText}</p>
                )
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const imageUploads = document.querySelectorAll(".image-upload");

        imageUploads.forEach((container) => {
            const fileInput = container.querySelector(
                'input[type="file"]',
            ) as HTMLInputElement;
            const previewContainer =
                container.querySelector(".preview-container");

            if (!fileInput || !previewContainer) return;

            fileInput.addEventListener("change", (e) => {
                const file = (e.target as HTMLInputElement).files?.[0];

                if (file) {
                    const reader = new FileReader();

                    reader.onload = (e) => {
                        const result = e.target?.result as string;

                        // Update preview
                        let img = previewContainer.querySelector(
                            ".preview-image",
                        ) as HTMLImageElement;

                        if (!img) {
                            // Create new image element
                            previewContainer.innerHTML = "";
                            img = document.createElement("img");
                            img.className =
                                "preview-image w-full h-full object-cover";
                            previewContainer.appendChild(img);
                        }

                        img.src = result;
                        previewContainer.classList.remove("border-dashed");
                    };

                    reader.readAsDataURL(file);
                }
            });
        });
    });
</script>
